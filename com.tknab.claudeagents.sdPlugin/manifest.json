{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Claude Agents",
  "UUID": "com.tknab.claudeagents",
  "Version": "1.0.0.0",
  "Author": "tknab",
  "Description": "A live status light per running Claude Code agent — green done, amber cooking, red needs you. Press to focus Claude.",
  "Category": "Claude Agents",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin/icon",
  "URL": "https://claude.com/claude-code",
  "SDKVersion": 2,
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "10.15" }
  ],
  "Actions": [
    {
      "Name": "Agent",
      "UUID": "com.tknab.claudeagents.slot",
      "Icon": "imgs/actions/agent/icon",
      "Tooltip": "Auto-fills with a live Claude agent; color = status, press = focus Claude.",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/agent/key", "TitleAlignment": "bottom", "ShowTitle": false }
      ]
    }
  ]
}
